# AI Business OS — environment configuration
# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
APP_SECRET=change-me-generate-a-random-64-char-string

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_business_os
REDIS_URL=redis://redis:6379/0

ENCRYPTION_KEY=change-me-generate-32-bytes-base64
JWT_SECRET=change-me-generate-a-random-64-char-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

AI_PROVIDER=ollama
AI_MODEL=llama3.1
OLLAMA_URL=http://ollama:11434

VECTOR_DB_URL=
EMAIL_PROVIDER=
CRM_PROVIDER=internal

STORAGE_PATH=/data/storage

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
